{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hardfilmstudios",
  "compatibility_date": "2026-05-14",
  "routes": [
    { "pattern": "hardfilmstudios.com", "custom_domain": true },
    { "pattern": "www.hardfilmstudios.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
