{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personalwebsite",
  "compatibility_date": "2026-05-14",
  "routes": [
    { "pattern": "hardfilmstudios.com", "custom_domain": true },
    { "pattern": "www.hardfilmstudios.com", "custom_domain": true }
  ],
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/google6f1c92c182dec82b.html"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
